{
  "name": "framework",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:enterprise": "npm --prefix examples/enterprise run dev",
    "dev:docs": "npm --prefix docs-consumer run dev",
    "build": "tsc --noEmit && vite build",
    "build:packages": "npm run build --workspaces --if-present",
    "build:enterprise": "npm --prefix examples/enterprise run build",
    "build:docs": "npm --prefix docs-consumer run build",
    "build:pages": "node scripts/build-pages.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "snapshot:docs": "node scripts/snapshot-docs.mjs",
    "fetch:docs-versions": "node scripts/fetch-docs-versions.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "npm run typecheck --workspaces --if-present",
    "typecheck:examples": "npm --prefix examples/enterprise run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:packages && npm run typecheck:examples",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ci:install": "node scripts/ci-install.mjs",
    "ci": "npm run typecheck:all && npm run build:packages && npm test",
    "publish": "node scripts/publish.mjs",
    "publish:dry": "node scripts/publish.mjs 0.0.0 --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/preact-mvc"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-preact": "^0.468.0",
    "preact": "^10.24.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@atolljs/core": "0.1.13",
    "@preact/preset-vite": "^2.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tinypool": "^2.1.2"
  }
}
