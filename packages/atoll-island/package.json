{
  "name": "@preact-mvc/atoll-island",
  "version": "0.0.0",
  "description": "preact-mvc island adapter: <Island/> shell components + Preact renderer for @preact-mvc/atoll worker islands",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@preact-mvc/atoll": "*",
    "@preact-mvc/core": "*",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@atolljs/core": "0.1.11",
    "@atolljs/islands": "0.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/preact-mvc",
    "directory": "packages/atoll-island"
  },
  "license": "MIT"
}
