{
  "name": "@preact-mvc/atoll",
  "version": "0.0.0",
  "description": "Framework-free worker-rendered islands: op protocol, proxy DOM, worker runtime, main-thread driver",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@atolljs/core": "0.1.11",
    "@atolljs/islands": "0.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/preact-mvc",
    "directory": "packages/atoll"
  },
  "license": "MIT"
}
