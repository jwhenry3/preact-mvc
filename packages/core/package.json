{
  "name": "@preact-mvc/core",
  "version": "0.0.0",
  "description": "Angular-inspired modules/DI/decorators + class-based JSX views rendered by Preact + signal reactivity",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0",
    "preact-router": "^4.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
